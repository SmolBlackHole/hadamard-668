{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:hadamard-668:run-v1",
  "title": "Hadamard-668 run manifest",
  "description": "Dokumentiert einen Suchlauf: Methode, Seeds, Metriken, Kandidaten-Hash. Dient der Reproduzierbarkeit und dem Vergleich von Suchergebnissen.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "result_type",
    "method_family",
    "search_scope",
    "coverage_kind",
    "seed_derivation",
    "seeds",
    "evaluations",
    "wall_seconds",
    "hardware_summary",
    "model_summary",
    "code_url",
    "code_commit",
    "parent_candidate_sha256",
    "candidate_sha256",
    "metrics",
    "publication_consent"
  ],
  "properties": {
    "schema_version": {
      "const": "h668-run-v1"
    },
    "result_type": {
      "enum": [
        "exact_solution",
        "checkpoint"
      ],
      "description": "exact_solution = Hadamard-Matrix gefunden, checkpoint = Zwischenstand"
    },
    "method_family": {
      "enum": [
        "gs_sds",
        "turyn",
        "sat_cp_pb",
        "alternative_algebraic",
        "local_search",
        "evolutionary_gpu",
        "literature_transfer",
        "other"
      ]
    },
    "search_scope": {
      "type": "string",
      "maxLength": 2000,
      "description": "Exakte Beschreibung des durchsuchten Parameterraums"
    },
    "coverage_kind": {
      "enum": [
        "heuristic",
        "exhaustive_claim",
        "certified"
      ]
    },
    "seed_derivation": {
      "type": [
        "string",
        "null"
      ],
      "maxLength": 512
    },
    "seeds": {
      "type": "array",
      "maxItems": 1024,
      "items": {
        "type": "string",
        "pattern": "^(0|[1-9][0-9]*)$"
      }
    },
    "evaluations": {
      "type": [
        "integer",
        "null"
      ],
      "minimum": 0,
      "description": "Anzahl evaluierter Kandidaten"
    },
    "wall_seconds": {
      "type": [
        "number",
        "null"
      ],
      "minimum": 0
    },
    "hardware_summary": {
      "type": [
        "string",
        "null"
      ],
      "maxLength": 256
    },
    "model_summary": {
      "type": [
        "string",
        "null"
      ],
      "maxLength": 256
    },
    "code_url": {
      "type": [
        "string",
        "null"
      ],
      "maxLength": 2048,
      "format": "uri"
    },
    "code_commit": {
      "anyOf": [
        {
          "type": "null"
        },
        {
          "type": "string",
          "pattern": "^[0-9a-fA-F]{7,64}$"
        }
      ]
    },
    "parent_candidate_sha256": {
      "anyOf": [
        {
          "type": "null"
        },
        {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      ],
      "description": "SHA-256 des vorherigen Kandidaten (bei iterativer Suche)"
    },
    "candidate_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$",
      "description": "SHA-256 der candidate.csv (normalisiert)"
    },
    "metrics": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "off_diagonal_energy",
        "orthogonal_row_pairs",
        "max_absolute_off_diagonal"
      ],
      "properties": {
        "off_diagonal_energy": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0,
          "description": "Summe der quadrierten Off-Diagonal-Eintraege von H*H^T. 0 = Hadamard."
        },
        "orthogonal_row_pairs": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0,
          "maximum": 222778
        },
        "max_absolute_off_diagonal": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0,
          "maximum": 668
        }
      }
    },
    "publication_consent": {
      "const": true,
      "description": "Zustimmung zur Veroeffentlichung der Daten"
    }
  }
}